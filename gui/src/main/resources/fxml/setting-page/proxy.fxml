<?xml version="1.0" encoding="UTF-8"?>

<?import com.catas.wicked.proxy.gui.componet.CustomTextField?>
<?import com.jfoenix.controls.JFXCheckBox?>
<?import com.jfoenix.controls.JFXComboBox?>
<?import com.jfoenix.controls.JFXToggleButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="settings-page-scroll"
            xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.catas.wicked.proxy.gui.controller.settings.ProxySettingsPageController">
    <content>
        <GridPane styleClass="settings-form, setting-server" hgap="16.0" vgap="8.0">
            <padding><Insets left="28.0" right="28.0" top="8.0" bottom="20.0"/></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="205.0" prefWidth="205.0" maxWidth="205.0"/>
                <ColumnConstraints minWidth="180.0" prefWidth="240.0" hgrow="ALWAYS"/>
            </columnConstraints>
            <Label fx:id="localProxySectionLabel" text="%local-proxy-sep.label" styleClass="settings-section-title"
                   GridPane.rowIndex="0" GridPane.columnSpan="2"/>
            <Label fx:id="listenPortLabel" text="%listen-port.label" styleClass="settings-field-label" GridPane.rowIndex="1"/>
            <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <HBox alignment="CENTER_LEFT" maxWidth="120.0" minWidth="120.0" prefWidth="120.0"
                      styleClass="port-stepper">
                    <CustomTextField fx:id="portField" maxWidth="94.0" minWidth="94.0" prefWidth="94.0"
                                     styleClass="port-stepper-field"
                                     errorPaneTranslateX="120.0" errorPaneTranslateY="-40.0"/>
                    <VBox maxWidth="26.0" minWidth="26.0" prefWidth="26.0" styleClass="port-stepper-buttons">
                        <Button fx:id="portIncrementButton" focusTraversable="false" mnemonicParsing="false"
                                onAction="#incrementPort" styleClass="port-stepper-button, port-stepper-up">
                            <graphic><FontIcon iconLiteral="fas-caret-up"/></graphic>
                        </Button>
                        <Button fx:id="portDecrementButton" focusTraversable="false" mnemonicParsing="false"
                                onAction="#decrementPort" styleClass="port-stepper-button, port-stepper-down">
                            <graphic><FontIcon iconLiteral="fas-caret-down"/></graphic>
                        </Button>
                    </VBox>
                </HBox>
                <Label fx:id="portUnavailableLabel" styleClass="port-unavailable-label"
                       maxWidth="190.0" wrapText="true" managed="false" visible="false"/>
            </HBox>

            <Label fx:id="systemProxySectionLabel" text="%sys-proxy-sep.label" styleClass="settings-section-title"
                   GridPane.rowIndex="2" GridPane.columnSpan="2"/>
            <Label fx:id="enableSystemProxyLabel" text="%enable-sys-proxy.label" styleClass="settings-field-label" GridPane.rowIndex="3"/>
            <JFXCheckBox fx:id="sysProxyOnLaunchBtn" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label fx:id="systemProxyBypassLabel" text="%sys-proxy-bypass.label" styleClass="settings-field-label" contentDisplay="RIGHT"
                   GridPane.rowIndex="4">
                <graphic>
                    <Label contentDisplay="GRAPHIC_ONLY" styleClass="tooltip-icon-host">
                        <graphic><FontIcon styleClass="tooltip-icon" iconLiteral="fas-question-circle"/></graphic>
                        <tooltip><Tooltip fx:id="systemProxyBypassTooltip" text="%host-path.tooltip" showDelay="0ms"/></tooltip>
                    </Label>
                </graphic>
            </Label>
            <TextArea fx:id="sysProxyExcludeArea" prefRowCount="2" wrapText="true"
                      GridPane.rowIndex="4" GridPane.columnIndex="1"
                      promptText="localhost; 127.0.0.1"/>

            <Label fx:id="throttleSectionLabel" text="%network-throttle-sep.label" styleClass="settings-section-title"
                   GridPane.rowIndex="5" GridPane.columnSpan="2"/>
            <Label fx:id="throttleLabel" text="%throttle.label" styleClass="settings-field-label" GridPane.rowIndex="6"/>
            <JFXToggleButton fx:id="throttleBtn" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            <Label fx:id="throttlePresetLabel" text="%throttle-preset.label" styleClass="settings-field-label" GridPane.rowIndex="7"/>
            <JFXComboBox fx:id="throttleComboBox" styleClass="settings-control"
                         GridPane.rowIndex="7" GridPane.columnIndex="1"/>

            <fx:include fx:id="upstreamProxySection" source="external-proxy.fxml"
                        GridPane.rowIndex="8" GridPane.columnSpan="2"/>
        </GridPane>
    </content>
</ScrollPane>
